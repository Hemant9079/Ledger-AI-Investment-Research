define host {
    use                     generic-host
    host_name               ledger-vercel-edge
    alias                   Ledger AI Vercel Production Deployment
    address                 {{ vercel_domain }}
    contact_groups          admins
    max_check_attempts      3
    check_period            24x7
    notification_interval   30
    notification_period     24x7
}

define service {
    use                     generic-service
    host_name               ledger-vercel-edge
    service_description     HTTPS Edge Health
    check_command           check_http!-H {{ vercel_domain }} -S --sni -u /api/health -e 200
}

define service {
    use                     generic-service
    host_name               ledger-vercel-edge
    service_description     SSL Certificate Validity
    check_command           check_http!-H {{ vercel_domain }} -C 14
}
