# Host Definition for Vercel Edge Deployment
define host {
    use                     generic-host
    host_name               vercel-ledger-ai
    alias                   Ledger AI Vercel Edge Production
    address                 {{ vercel_domain | default('ledger-ai-investment-research.vercel.app') }}
    check_command           check_http!-H {{ vercel_domain | default('ledger-ai-investment-research.vercel.app') }} -S --ssl
    max_check_attempts      3
    check_period            24x7
    notification_interval   30
    notification_period     24x7
}

# 1. Vercel Production HTTPS Status (Port 443)
define service {
    use                     generic-service
    host_name               vercel-ledger-ai
    service_description     Vercel Production HTTPS
    check_command           check_http!-H {{ vercel_domain | default('ledger-ai-investment-research.vercel.app') }} -S --ssl -u /
}

# 2. Vercel SSL Certificate Expiry Check
define service {
    use                     generic-service
    host_name               vercel-ledger-ai
    service_description     Vercel SSL Certificate Expiry
    check_command           check_http!-H {{ vercel_domain | default('ledger-ai-investment-research.vercel.app') }} -C 14,7
}

# 3. Vercel Docs Page Availability
define service {
    use                     generic-service
    host_name               vercel-ledger-ai
    service_description     Vercel Docs Endpoint (/docs)
    check_command           check_http!-H {{ vercel_domain | default('ledger-ai-investment-research.vercel.app') }} -S --ssl -u /docs
}

