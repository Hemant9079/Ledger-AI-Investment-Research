# Host Definition for Ledger AI Application Server
define host {
    use                     linux-server
    host_name               ledger-app-server
    alias                   Ledger AI Next.js App Host
    address                 {{ hostvars[groups['app_servers'][0]]['private_ip'] | default(hostvars[groups['app_servers'][0]]['ansible_host']) }}
    max_check_attempts      3
    check_period            24x7
    notification_interval   30
    notification_period     24x7
}

# 1. PING Check
define service {
    use                     generic-service
    host_name               ledger-app-server
    service_description     PING Connectivity
    check_command           check_ping!100.0,20%!500.0,60%
}

# 2. SSH Service Check
define service {
    use                     generic-service
    host_name               ledger-app-server
    service_description     SSH Service (Port 22)
    check_command           check_ssh
}

# 3. HTTP Web Server (Port 80)
define service {
    use                     generic-service
    host_name               ledger-app-server
    service_description     HTTP Web UI (Nginx)
    check_command           check_http!-p 80 -u /
}

# 4. HTTP Health Check Endpoint (/health)
define service {
    use                     generic-service
    host_name               ledger-app-server
    service_description     HTTP Application Health (/health)
    check_command           check_http!-p 80 -u /health
}

# 5. NRPE - CPU Load
define service {
    use                     generic-service
    host_name               ledger-app-server
    service_description     CPU Load Average
    check_command           check_nrpe!check_cpu
}

# 6. NRPE - Memory (RAM) Usage
define service {
    use                     generic-service
    host_name               ledger-app-server
    service_description     Memory (RAM) Usage
    check_command           check_nrpe!check_mem
}

# 7. NRPE - Root Disk Space
define service {
    use                     generic-service
    host_name               ledger-app-server
    service_description     Root Disk Usage (/)
    check_command           check_nrpe!check_disk
}

# 8. NRPE - PM2 Application Process
define service {
    use                     generic-service
    host_name               ledger-app-server
    service_description     Ledger AI PM2 Process
    check_command           check_nrpe!check_pm2
}

