define host {
    use                     generic-host
    host_name               ledger-app-server
    alias                   Ledger AI Application Server (EC2)
    address                 {{ hostvars['app_server']['ansible_default_ipv4']['address'] | default(hostvars['app_server']['ansible_host']) }}
    contact_groups          admins
    max_check_attempts      3
    check_period            24x7
    notification_interval   30
    notification_period     24x7
}

define service {
    use                     generic-service
    host_name               ledger-app-server
    service_description     PING Connectivity
    check_command           check_ping!100.0,20%!500.0,60%
}

define service {
    use                     generic-service
    host_name               ledger-app-server
    service_description     SSH Port 22
    check_command           check_ssh
}

define service {
    use                     generic-service
    host_name               ledger-app-server
    service_description     HTTP Web Application
    check_command           check_http!-u / -p 80 -e 200,301,302,307
}

define service {
    use                     generic-service
    host_name               ledger-app-server
    service_description     API Health Endpoint
    check_command           check_http!-u /api/health -p 80 -e 200
}

define service {
    use                     generic-service
    host_name               ledger-app-server
    service_description     CPU Load NRPE
    check_command           check_nrpe!check_cpu
}

define service {
    use                     generic-service
    host_name               ledger-app-server
    service_description     Memory Usage NRPE
    check_command           check_nrpe!check_mem
}

define service {
    use                     generic-service
    host_name               ledger-app-server
    service_description     Disk Space Root NRPE
    check_command           check_nrpe!check_disk
}

define service {
    use                     generic-service
    host_name               ledger-app-server
    service_description     PM2 Cluster Process NRPE
    check_command           check_nrpe!check_pm2
}
